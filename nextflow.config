manifest {
    name = 'virpipa'
    description = 'HCV probe-capture assembly pipeline'
    mainScript = 'main.nf'
    version = '0.2.0'
}

params {
    input = ''
    csv = ''
    outdir = "results"

    scripts_dir = "scripts"
    ref_dir = "refgenomes"
    assets_dir = "assets"
    container_dir = ''
    bind_paths = '/fs1,/fs2,/local'
    hostile_cache_dir = ''

    remove_human = true
    subsample_reads = 1000000
    use_sentieon = true
    genome = ''
    maxpolish = 10
    
    blast_db = ''
    vadr_model = 'vadr-models-flavi'
    vadr_model_dir = ''
    vadr_container = ''
    resistance_rules = "assets/hcv_geno2pheno_rules.csv"
    container_runtime = ''
    sample_info_json = ''
    publish_mode = 'routine'

    cpus = 16
    memory = '32 GB'
    time = '24h'

    partition = ''
    queue = ''
    run_name = ''
    pipeline_info = false
    pipeline_info_dag = false
    completion_log_dir = ''
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process {
            executor = 'slurm'
            queue = params.partition ?: params.queue ?: null
            cpus = 2
            memory = '4 GB'
            time = '1h'

            withName: REMOVE_HOSTILE {
                cpus = 12
                memory = '6 GB'
                time = '2h'
            }
            withName: 'SUBSAMPLE_READS|SUBSAMPLE_READS_REFSEL' {
                cpus = 4
                memory = '2 GB'
                time = '1h'
            }
            withName: 'BAM2FASTA_BESTREF|BAM2FASTA_PILON|BAM2FASTA' {
                cpus = 8
                memory = '4 GB'
                time = '1h'
            }
            withName: ASSEMBLE_SPADES {
                cpus = 12
                memory = '16 GB'
                time = '4h'
            }
            withName: ASSEMBLE_HYBRID {
                cpus = 4
                memory = '4 GB'
                time = '1h'
            }
            withName: MAP_READS {
                cpus = 8
                memory = '8 GB'
                time = '1h'
            }
            withName: MAP_READS_NOOPT {
                cpus = 8
                memory = '12 GB'
                time = '1h'
            }
            withName: POLISH_PILON_LOOP {
                cpus = 8
                memory = '16 GB'
                time = '2h'
            }
            withName: CREATE_CONSENSUS {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: FILTER_VCF {
                cpus = 4
                memory = '2 GB'
                time = '30m'
            }
            withName: VARIANT_CALLING {
                cpus = 8
                memory = '4 GB'
                time = '30m'
            }
            withName: 'CREATE_CRAM_BESTREF|CREATE_CRAM_PILON|CREATE_CRAM_IUPAC|CREATE_CRAM' {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: 'SUBTYPE_BLAST_MAIN|SUBTYPE_BLAST_PILON_IUPAC|SUBTYPE_BLAST_IUPAC|SUBTYPE_BLAST' {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: 'CREATE_REPORT_BESTREF|CREATE_REPORT_IUPAC|CREATE_REPORT' {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: ANNOTATE_VADR {
                cpus = 2
                memory = '12 GB'
                time = '1h'
            }
            withName: ANNOTATE_RESISTANCE {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: FINALIZE_RESULTS {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: LOG_COVERAGE {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: SELECT_BEST_REFERENCE {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
        }
    }

    local {
        params {
            bind_paths = '/mnt,/home,/tmp'
            container_dir = ''
            hostile_cache_dir = '/home/jonas/resources/hostile'
            vadr_model_dir = '/home/jonas/resources/vadr/vadr-models-flavi'
            scripts_dir = "${projectDir}/scripts"
        }
        env {
            VIRPIPA_BIND_PATHS = '/mnt,/home,/tmp'
            VIRPIPA_SCRIPTS_DIR = "${projectDir}/scripts"
            VIRPIPA_HOSTILE_CACHE_DIR = '/home/jonas/resources/hostile'
            VIRPIPA_VADR_MODEL_DIR = '/home/jonas/resources/vadr/vadr-models-flavi'
        }
        process.memory = '8 GB'
        process.cpus = 8
        process {
            withName: REMOVE_HOSTILE {
                cpus = 4
                memory = '10 GB'
                time = '1h'
            }
            withName: SUBSAMPLE_READS {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: BAM2FASTA {
                cpus = 2
                memory = '4 GB'
                time = '30m'
            }
            withName: ASSEMBLE_SPADES {
                cpus = 8
                memory = '15 GB'
                time = '8h'
            }
            withName: ASSEMBLE_HYBRID {
                cpus = 8
                memory = '15 GB'
                time = '4h'
            }
            withName: MAP_READS {
                cpus = 4
                memory = '8 GB'
                time = '1h'
            }
            withName: MAP_READS_NOOPT {
                cpus = 4
                memory = '8 GB'
                time = '1h'
            }
            withName: POLISH_PILON_LOOP {
                cpus = 4
                memory = '10 GB'
                time = '2h'
            }
            withName: CREATE_CONSENSUS {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: FILTER_VCF {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: VARIANT_CALLING {
                cpus = 2
                memory = '4 GB'
                time = '30m'
            }
            withName: CREATE_CRAM {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: SUBTYPE_BLAST {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: CREATE_REPORT {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: ANNOTATE_VADR {
                cpus = 2
                memory = '8 GB'
                time = '1h'
            }
        }
    }

    local_containers {
        params {
            bind_paths = '/mnt,/home,/tmp'
            container_dir = "${projectDir}/assets/containers"
            hostile_cache_dir = '/home/jonas/resources/hostile'
            vadr_model_dir = '/home/jonas/resources/vadr/vadr-models-flavi'
            scripts_dir = "${projectDir}/scripts"
        }
        env {
            VIRPIPA_CONTAINER_DIR = "${projectDir}/assets/containers"
            VIRPIPA_BIND_PATHS = '/mnt,/home,/tmp'
            VIRPIPA_SCRIPTS_DIR = "${projectDir}/scripts"
            VIRPIPA_HOSTILE_CACHE_DIR = '/home/jonas/resources/hostile'
            VIRPIPA_VADR_MODEL_DIR = '/home/jonas/resources/vadr/vadr-models-flavi'
        }
        process.memory = '8 GB'
        process.cpus = 8
        process {
            withName: REMOVE_HOSTILE {
                cpus = 4
                memory = '10 GB'
                time = '1h'
            }
            withName: SUBSAMPLE_READS {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: BAM2FASTA {
                cpus = 2
                memory = '4 GB'
                time = '30m'
            }
            withName: ASSEMBLE_SPADES {
                cpus = 8
                memory = '15 GB'
                time = '8h'
            }
            withName: ASSEMBLE_HYBRID {
                cpus = 8
                memory = '15 GB'
                time = '4h'
            }
            withName: MAP_READS {
                cpus = 4
                memory = '8 GB'
                time = '1h'
            }
            withName: MAP_READS_NOOPT {
                cpus = 4
                memory = '8 GB'
                time = '1h'
            }
            withName: POLISH_PILON_LOOP {
                cpus = 4
                memory = '10 GB'
                time = '2h'
            }
            withName: CREATE_CONSENSUS {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: FILTER_VCF {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: VARIANT_CALLING {
                cpus = 2
                memory = '4 GB'
                time = '30m'
            }
            withName: CREATE_CRAM {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: SUBTYPE_BLAST {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: CREATE_REPORT {
                cpus = 2
                memory = '2 GB'
                time = '30m'
            }
            withName: ANNOTATE_VADR {
                cpus = 2
                memory = '8 GB'
                time = '1h'
            }
        }
    }

    tiny {
        params {
            input = "${projectDir}/assets/tiny_samplesheet.csv"
            outdir = "${projectDir}/results_tiny"
        }
    }

    hpc {
        params {
            container_dir = '/fs1/resources/containers'
            bind_paths = '/fs1,/fs2,/local,/mnt/beegfs'
            hostile_cache_dir = '/fs1/resources/ref/micro/hostile'
            vadr_model_dir = '/fs1/resources/ref/micro/vadr/vadr-models-flavi'
            scripts_dir = '/fs1/jonas/src/virpipa/scripts'
        }
        env {
            VIRPIPA_CONTAINER_DIR = '/fs1/resources/containers'
            VIRPIPA_BIND_PATHS = '/fs1,/fs2,/local,/mnt/beegfs'
            VIRPIPA_SCRIPTS_DIR = '/fs1/jonas/src/virpipa/scripts'
            VIRPIPA_HOSTILE_CACHE_DIR = '/fs1/resources/ref/micro/hostile'
            VIRPIPA_VADR_MODEL_DIR = '/fs1/resources/ref/micro/vadr/vadr-models-flavi'
        }
    }

    apptainer {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${projectDir}/.singularity"
    }

    test {
        params {
            input = "${projectDir}/assets/test_samplesheet.csv"
            outdir = "${projectDir}/results_test"
        }
    }
}

includeConfig 'conf/base.config'
